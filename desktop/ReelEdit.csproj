<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ReelEdit</AssemblyName>
    <RootNamespace>ReelEdit</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Reel Edit</Product>
    <Company>Polytricity</Company>
    <!-- version and build number come from ../version.json, same as the web page -->
    <VerJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\version.json'))</VerJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($(VerJson), '(?s).*"version"\s*:\s*"([^"]+)".*', '$1'))</Version>
    <AppBuild>$([System.Text.RegularExpressions.Regex]::Replace($(VerJson), '(?s).*"build"\s*:\s*(\d+).*', '$1'))</AppBuild>
    <FileVersion>$(Version).$(AppBuild)</FileVersion>
    <AssemblyVersion>$(Version).$(AppBuild)</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- one self-contained exe: no .NET install needed on the target machine -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <TieredPGO>true</TieredPGO>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ReelEdit.html" LogicalName="ReelEdit.html" />
  </ItemGroup>

  <!-- rebuild the single-file web app from src/ before compiling it in -->
  <Target Name="BuildWebApp" BeforeTargets="BeforeBuild">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\src\build.js&quot;" />
  </Target>

</Project>
